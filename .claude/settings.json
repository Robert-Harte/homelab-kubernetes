{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/yaml-format.py 2>/dev/null || true",
            "statusMessage": "Formatting YAML..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(curl *)",
      "Bash(git pull *)",
      "Skill(claude-api)",
      "Bash(git ls-tree *)"
    ]
  }
}
